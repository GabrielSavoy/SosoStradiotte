<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sofia Stradiotte — Portfólio</title>
<meta name="description" content="Portfólio de Sofia Stradiotte, estudante de Moda na FAAP.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Alex+Brush&family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="css/style.css">
</head>
<body>

<div class="site-wrapper">

  <!-- ===== NAVBAR ===== -->
  <header class="navbar">
    <a href="index.html" class="logo">🎀 Sofia Stradiotte 🎀</a>

    <nav>
      <ul class="nav-links">
        <li><a href="index.html" class="active">Início</a></li>
        <li><a href="sobre.html">Sobre Mim</a></li>
        <li><a href="portfolio.html">Portfólio</a></li>
        <li><a href="fotos.html">Fotos</a></li>
        <li><a href="curriculo.html">Currículo</a></li>
        <li><a href="contato.html">Contato</a></li>
        <li><a href="contato.html" class="btn-cta">Vamos conversar! ✉</a></li>
      </ul>
    </nav>

    <button class="hamburger" aria-label="Abrir menu">
      <span></span><span></span><span></span>
    </button>
  </header>

  <!-- ===== HERO ===== -->
  <section class="hero">

    <!-- agulha com linha, bem fina, mesma cor/traço do manequim e da borboleta -->
    <div class="deco-stitch deco-needle">
      <svg viewBox="0 0 40 100" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
        <line x1="20" y1="10" x2="20" y2="88"/>
        <ellipse cx="20" cy="8" rx="3" ry="5"/>
        <path d="M20 88 L16 96 M20 88 L24 96"/>
        <path d="M20 8 C10 16, 4 28, 11 36 C18 44, 8 52, 14 60" stroke-width="0.8"/>
      </svg>
    </div>

    <!-- alfinete pequeno -->
    <div class="deco-stitch deco-pin">
      <svg viewBox="0 0 60 20" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round">
        <line x1="10" y1="10" x2="54" y2="10"/>
        <circle cx="8" cy="10" r="4" fill="currentColor" stroke="none"/>
      </svg>
    </div>

    <div class="hero-text">
      <p class="eyebrow">olá, eu sou a
        <svg class="icon-heart" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 20s-7-4.5-9.5-9C1 7 3 3.5 6.5 3.5c2 0 3.5 1.3 4.5 3 1-1.7 2.5-3 4.5-3C19 3.5 21 7 19.5 11c-2.5 4.5-9.5 9-9.5 9z"/></svg>
      </p>
      <h1 class="script-title">
        Sofia Stradiotte
        <svg class="title-underline" viewBox="0 0 320 20" preserveAspectRatio="none">
          <path d="M4 10 Q 80 2, 160 10 T 316 10" stroke="var(--accent-light)" stroke-width="6" fill="none" stroke-linecap="round"/>
        </svg>
      </h1>
      <p class="desc">Estudante de Moda na FAAP apaixonada por criação, estilo e contar histórias através do design.
        <svg class="icon-heart" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 20s-7-4.5-9.5-9C1 7 3 3.5 6.5 3.5c2 0 3.5 1.3 4.5 3 1-1.7 2.5-3 4.5-3C19 3.5 21 7 19.5 11c-2.5 4.5-9.5 9-9.5 9z"/></svg>
      </p>
      <a href="sobre.html" class="btn-primary">Saiba mais sobre mim →</a>
    </div>

    <div class="hero-image">
      <div class="polaroid">
        <div class="tape"></div>
        <div class="photo-placeholder">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="3" y="7" width="18" height="13" rx="2"/>
            <path d="M8 7l2-3h4l2 3"/>
            <circle cx="12" cy="13.5" r="3.5"/>
          </svg>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== CARDS ===== -->
  <section class="cards-grid">

    <div class="card">
      <span class="card-accent top-right">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c.6 4.8 2.6 8 7 9-4.4 1-6.4 4.2-7 9-.6-4.8-2.6-8-7-9 4.4-1 6.4-4.2 7-9z"/></svg>
      </span>
      <div class="card-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="12" cy="8" r="4"/>
          <path d="M4 20c0-4 4-6 8-6s8 2 8 6"/>
        </svg>
      </div>
      <h3>Sobre Mim</h3>
      <p>Um pouco sobre quem sou, minha trajetória e minhas paixões.</p>
      <a href="sobre.html" class="acessar">Acessar →</a>
    </div>

    <div class="card">
      <span class="card-accent top-right">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c.6 4.8 2.6 8 7 9-4.4 1-6.4 4.2-7 9-.6-4.8-2.6-8-7-9 4.4-1 6.4-4.2 7-9z"/></svg>
      </span>
      <div class="card-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M3 7a2 2 0 012-2h4l2 2h8a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V7z"/>
        </svg>
      </div>
      <h3>Portfólio</h3>
      <p>Confira meus projetos e trabalhos acadêmicos de Moda.</p>
      <a href="portfolio.html" class="acessar">Acessar →</a>
    </div>

    <div class="card">
      <span class="card-accent bottom-left">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 20s-7-4.5-9.5-9C1 7 3 3.5 6.5 3.5c2 0 3.5 1.3 4.5 3 1-1.7 2.5-3 4.5-3C19 3.5 21 7 19.5 11c-2.5 4.5-9.5 9-9.5 9z"/></svg>
      </span>
      <div class="card-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <rect x="3" y="7" width="18" height="13" rx="2"/>
          <path d="M8 7l2-3h4l2 3"/>
          <circle cx="12" cy="13.5" r="3.5"/>
        </svg>
      </div>
      <h3>Fotos</h3>
      <p>Uma seleção especial de fotos e registros que me inspiram.</p>
      <a href="fotos.html" class="acessar">Acessar →</a>
    </div>

    <div class="card">
      <span class="card-accent top-right">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c.6 4.8 2.6 8 7 9-4.4 1-6.4 4.2-7 9-.6-4.8-2.6-8-7-9 4.4-1 6.4-4.2 7-9z"/></svg>
      </span>
      <div class="card-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M6 2h8l4 4v16H6z"/>
          <path d="M14 2v4h4"/>
          <line x1="9" y1="13" x2="15" y2="13"/>
          <line x1="9" y1="17" x2="15" y2="17"/>
        </svg>
      </div>
      <h3>Currículo</h3>
      <p>Veja minha formação, experiências e habilidades.</p>
      <a href="curriculo.html" class="acessar">Acessar →</a>
    </div>

    <div class="card">
      <span class="card-accent top-right">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c.6 4.8 2.6 8 7 9-4.4 1-6.4 4.2-7 9-.6-4.8-2.6-8-7-9 4.4-1 6.4-4.2 7-9z"/></svg>
      </span>
      <div class="card-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <rect x="3" y="5" width="18" height="14" rx="2"/>
          <path d="M3 7l9 6 9-6"/>
        </svg>
      </div>
      <h3>Contato</h3>
      <p>Vamos conversar? Estou aberta a novas conexões!</p>
      <a href="contato.html" class="acessar">Acessar →</a>
    </div>

  </section>

  <!-- ===== FOOTER ===== -->
  <footer class="footer">
    <div class="socials">
      <a href="#" aria-label="Instagram">📷</a>
      <a href="#" aria-label="Pinterest">📌</a>
      <a href="#" aria-label="E-mail">✉️</a>
    </div>
    <div class="footer-center">
      <p>🩷 Feito com amor 🩷</p>
      <p>© 2026 Sofia Stradiotte. Todos os direitos reservados.</p>
    </div>
    <div class="footer-deco">🎀</div>
  </footer>

</div>

<script src="js/script.js"></script>
</body>
</html>
